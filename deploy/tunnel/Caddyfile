# Single-origin demo server for the Cloudflare Tunnel (see README.md).
# Serves the production build of /v2 and forwards only the V2 API and the V2 voice socket.
{
	admin off
	auto_https off
	# cloudflared connects from the Docker host gateway (a private address): keep its X-Forwarded-* chain.
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "microphone=(self), geolocation=(self), camera=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Round 1 lives at / and needs endpoints that are off in V2: send visitors to the V2 app.
	@root path /
	redir @root /v2 302

	# Only these reach FastAPI. The Host header is passed through unchanged, so the backend's
	# same-origin WebSocket check (Origin host == Host) keeps working behind the tunnel.
	@backend path /api/v2/* /api/health /ws/v2/session
	handle @backend {
		reverse_proxy {$ASHA_UPSTREAM:api:8000}
	}

	# Any other /api or /ws path (Round 1 endpoints) stops here. FastAPI /docs and /openapi.json
	# are not forwarded at all: those paths fall through to the static app below.
	handle /api/* {
		respond 404
	}
	handle /ws/* {
		respond 404
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
