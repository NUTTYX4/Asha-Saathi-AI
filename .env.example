# ==============================================================================
# ASHA SAATHI AI — environment template
# Copy to `.env` at the repository root and fill in values. NEVER commit `.env`.
# The backend reads this file. The frontend never sees any of these values:
# every Gnani call is proxied through the FastAPI backend.
# ==============================================================================

# --- Backend ---
APP_ENV=development
# Host/port are set on the uvicorn command line (127.0.0.1:8000; see README), not here.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
DATABASE_PATH=./data/asha_saathi.db

# --- V2 PostgreSQL/PostGIS (Docker Compose) ---
# Local development database password. Generate a random value; never reuse a real password.
# Compose builds DATABASE_URL from it; the database port is not published outside Docker.
POSTGRES_PASSWORD=

# Round 1 endpoints (/api/visits, /api/followups, /ws/session) have NO login. In V2 (Docker,
# PostgreSQL) they are OFF by default. Set true only for a temporary Round 1-UI demo.
# LEGACY_ROUND1_API_ENABLED=false
# V2 person-bound voice visits (/ws/v2/session): OFF by default. Set true to run live Gnani voice.
# V2_VOICE_ENABLED=false

# --- Gnani API Platform (backend only) ---
# Create a key at https://app.gnani.ai/voice  (docs: https://docs.gnani.ai)
GNANI_API_KEY=[ENCRYPTION_KEY]

# Prisma v3.0 realtime STT (https://docs.gnani.ai/api/STT/stt-websocket)
PRISMA_WS_URL=wss://api.vachana.ai/stt/v3/stream
PRISMA_MODEL=prisma-v3.0
# Exactly one locale: the live API rejects a comma-separated list ("exactly one locale is
# required"), despite the docs. codemix format still returns English words in Latin script.
PRISMA_LANGUAGES=kn-IN
# verbatim | transcribe | codemix | transliterate
PRISMA_FORMAT=codemix
# End-of-speech silence before a segment closes (100-2000 ms, default 500)
PRISMA_MIN_SILENCE_MS=700

# Timbre v3.0 TTS (https://docs.gnani.ai/api/TTS/tts-inference)
TIMBRE_URL=https://api.vachana.ai/api/v1/tts/inference
TIMBRE_MODEL=timbre-v3.0
# Case-sensitive voice name from the timbre-v3.0 catalog
TIMBRE_VOICE=Shruthi
TIMBRE_LANGUAGE=kn-IN
TIMBRE_SAMPLE_RATE=24000
