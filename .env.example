# ==============================================================================
# ASHA SAATHI AI — Root Environment Configuration Template
# Copy this file to `.env` at the repository root and fill in real values.
# NEVER commit `.env` to Git.
#
# Security note:
# - Backend reads all variables from this root `.env`.
# - Frontend (Vite with `envDir: '..'`) ONLY exposes `VITE_*` variables to the
#   browser. Never prefix API keys or secrets with `VITE_`.
# ==============================================================================

# --- App / Environment ---
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Database (Prototype: SQLite) ---
DATABASE_URL=sqlite:///./data/asha_saathi.db

# --- Gnani.ai Voice Services (Backend ONLY — never expose to browser) ---
# Fill in exact fields once Gnani Prisma v3.0 & Timbre v3.0 credentials/docs are verified
GNANI_API_KEY=
GNANI_PRISMA_WS_URL=
GNANI_TIMBRE_API_URL=

# --- LLM Structured Extraction (Backend ONLY) ---
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Frontend Public Config (Safe for browser via VITE_ prefix) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
