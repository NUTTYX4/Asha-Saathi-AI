{
  "name": "asha-saathi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:types": "json2ts -i ../contracts/contracts.schema.json -o src/types/contracts.ts --bannerComment \"/* AUTO-GENERATED from backend Pydantic schemas (contracts/contracts.schema.json). Do not edit; run npm run gen:types. */\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.7",
    "@types/react": "18.3.21",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-basic-ssl": "2.0.0",
    "@vitejs/plugin-react": "4.4.1",
    "json-schema-to-typescript": "15.0.4",
    "tailwindcss": "4.1.7",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
